{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omi-shapeforge:run:1",
  "title": "ShapeForge run contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "run_id",
    "workflow",
    "started_utc",
    "finished_utc",
    "execution",
    "sources",
    "environment",
    "parameters",
    "inputs",
    "artifacts",
    "validation",
    "acceptance",
    "legacy",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_kind": {
      "enum": [
        "native",
        "imported",
        "example"
      ]
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "workflow": {
      "type": "string",
      "minLength": 1
    },
    "started_utc": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "finished_utc": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "returncode",
        "command",
        "cwd",
        "log",
        "error"
      ],
      "properties": {
        "state": {
          "enum": [
            "pending",
            "running",
            "succeeded",
            "failed",
            "cancelled",
            "unknown"
          ]
        },
        "returncode": {
          "type": [
            "integer",
            "null"
          ]
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "cwd": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "log": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "error": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 0
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable",
        "versions"
      ],
      "properties": {
        "executable": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "parameters": {
      "type": "object"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      },
      "minItems": 0
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      },
      "minItems": 0
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "checks"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed",
            "not_evaluated"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          },
          "minItems": 0
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "scope",
        "checks"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed",
            "not_evaluated"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          },
          "minItems": 0
        }
      }
    },
    "legacy": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "adapter_version",
            "documents",
            "raw_status",
            "missing_fields"
          ],
          "properties": {
            "format": {
              "type": "string",
              "minLength": 1
            },
            "adapter_version": {
              "const": 1
            },
            "documents": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/file"
              },
              "minItems": 1
            },
            "raw_status": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "missing_fields": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            }
          }
        }
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "sha256",
        "size_bytes",
        "format",
        "units",
        "frame"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "format": {
          "type": "string",
          "minLength": 1
        },
        "units": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "frame": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "method",
        "expected",
        "observed",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "not_evaluated"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "expected": {
          "type": "string",
          "minLength": 1
        },
        "observed": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "head",
        "dirty",
        "entrypoint_sha256",
        "note"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "head": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        },
        "dirty": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "entrypoint_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "note": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    }
  }
}
