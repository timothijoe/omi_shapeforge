        "checkpoint",
        "model_config"
      ],
      "required_artifacts": {
        "report": {
          "path": "backend/report.json",
          "format": "json",
          "units": null,
          "frame": null
        },
        "disparity": {
          "path": "backend/disparity.npy",
          "format": "npy",
          "units": "pixel",
          "frame": "left_image"
        },
        "depth": {
          "path": "backend/depth_meter.npy",
          "format": "npy",
          "units": "m",
          "frame": "camera"
        },
        "cloud": {
          "path": "backend/cloud.ply",
          "format": "ply",
          "units": "m",
          "frame": "camera"
        },
        "preview": {
          "path": "backend/vis.png",
          "format": "png",
          "units": null,
          "frame": null
        }
      },
      "content_rules": [
        "RGB input sizes agree; intrinsics and baseline are valid",
        "disparity/depth are finite HxW arrays matching input size; depth is nonnegative",
        "PLY is readable with finite coordinates and positive point count matching report",
        "PNG is decodable; report image_shape and iterations match resolved parameters"
      ],
      "acceptance_checks": [
        "official_sample_checks"
      ]
    },
